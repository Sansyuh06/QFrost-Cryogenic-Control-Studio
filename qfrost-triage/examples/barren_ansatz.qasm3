OPENQASM 3.0;
include "stdgates.inc";

// 12-qubit Parameterized Hardware-Efficient Ansatz with Global Observable
input float[64] theta;
input float[64] phi;
qubit[12] q;
bit[12] c;

// Layer 1: Parameterized rotations
rx(theta) q[0];
rx(theta) q[1];
rx(theta) q[2];
rx(theta) q[3];
rx(theta) q[4];
rx(theta) q[5];
rx(theta) q[6];
rx(theta) q[7];
rx(theta) q[8];
rx(theta) q[9];
rx(theta) q[10];
rx(theta) q[11];

// Layer 2: Entangling ring
cx q[0], q[1];
cx q[1], q[2];
cx q[2], q[3];
cx q[3], q[4];
cx q[4], q[5];
cx q[5], q[6];
cx q[6], q[7];
cx q[7], q[8];
cx q[8], q[9];
cx q[9], q[10];
cx q[10], q[11];
cx q[11], q[0];

// Layer 3: Parameterized rotations
ry(phi) q[0];
ry(phi) q[1];
ry(phi) q[2];
ry(phi) q[3];
ry(phi) q[4];
ry(phi) q[5];
ry(phi) q[6];
ry(phi) q[7];
ry(phi) q[8];
ry(phi) q[9];
ry(phi) q[10];
ry(phi) q[11];

// Global observable measurement (all 12 qubits projected onto classical register)
c[0] = measure q[0];
c[1] = measure q[1];
c[2] = measure q[2];
c[3] = measure q[3];
c[4] = measure q[4];
c[5] = measure q[5];
c[6] = measure q[6];
c[7] = measure q[7];
c[8] = measure q[8];
c[9] = measure q[9];
c[10] = measure q[10];
c[11] = measure q[11];
